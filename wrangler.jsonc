{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "5b23be343baa16154aaf959302d90a0d",
  "name": "ignite-academy",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  // @lovable.dev/vite-tanstack-config outputs Nitro cloudflare-module to dist/server + dist/client.
  "main": "dist/server/index.mjs",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "SUPABASE_URL": "https://aijukbdxyawxzekwhrdo.supabase.co"
  }
}
